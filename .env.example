# AAWAZ Backend Environment Configuration Example
# Database Connection URL (MySQL or SQLite fallback)
DATABASE_URL=mysql+pymysql://root:root@localhost:3307/aawaz_db
# For SQLite fallback, use:
# DATABASE_URL=sqlite:///./aawaz.db

# Server Bind Settings
PORT=8000
HOST=0.0.0.0

# Storage Paths (relative to backend root or absolute)
MUSIC_STORAGE_PATH=./music
COVER_STORAGE_PATH=./covers
STORAGE_BACKEND=local

# CORS Allowed Origins (comma-separated list)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# YouTube Data API v3 Configuration
YOUTUBE_API_KEY=
